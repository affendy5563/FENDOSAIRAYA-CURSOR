<!doctype html>
<html lang="ms">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Projek CT - Fendosairaya (Custom Cursor -> Slack)</title>
  <style>
    /* Sembunyikan kursor default */
    * { cursor: none; }

    body{
      font-family: Arial, sans-serif;
      text-align: center;
      margin: 60px;
    }

    /* Elemen kursor custom */
    #custom-cursor{
      position: fixed;
      left: 0;
      top: 0;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: rgba(0,0,0,0.8);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none; /* jangan ganggu klik */
      transform: translate(-50%, -50%) scale(1);
      transition: width 0.12s ease, height 0.12s ease, transform 0.12s ease, background 0.12s ease;
      z-index: 9999;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }

    /* Gaya bila menukar ke Slack */
    #custom-cursor.slack {
      width: 44px;
      height: 44px;
      border-radius: 8px;
      background: #ffffff;
      color: transparent; /* kita guna SVG berwarna */
      transform: translate(-50%, -50%) scale(1.02);
      box-shadow: 0 6px 18px rgba(0,0,0,0.25);
    }

    /* Sekiranya klik (anim kecil) */
    #custom-cursor.active {
      transform: translate(-50%, -50%) scale(0.85);
    }

    /* Contoh pautan Slack (letakkan data-cursor="slack") */
    .slack-link{
      display: inline-block;
      margin: 20px;
      padding: 12px 18px;
      background: #4A154B;
      color: #fff;
      text-decoration: none;
      border-radius: 8px;
    }

    /* Perkara lain di halaman untuk ujian */
    .box{
      display:inline-block;
      margin: 12px;
      padding: 18px;
      background:#f1f1f1;
      border-radius:8px;
    }
  </style>
</head>
<body>
  <h1>Selamat Datang ke Projek CT</h1>
  <p>Ini adalah tapak permulaan laman web saya. Cubalah hover pada butang Slack di bawah.</p>

  <a href="https://slack.com" class="slack-link" data-cursor="slack" target="_blank" rel="noreferrer">Buka Slack</a>

  <div class="box" data-cursor="default">Kotak biasa</div>
  <div class="box" data-cursor="default">Kotak 2</div>

  <!-- Elemen kursor (dibuat oleh JS jika tiada) -->
  <div id="custom-cursor" aria-hidden="true">
    <!-- Default: kosong (bulatan) -->
  </div>

  <script>
    (function(){
      const cursor = document.getElementById('custom-cursor');

      // Lerp untuk pergerakan yang licin
      let mouseX = window.innerWidth / 2, mouseY = window.innerHeight / 2;
      let posX = mouseX, posY = mouseY;
      const ease = 0.18;

      // Update posisi kursor visual
      function animate(){
        posX += (mouseX - posX) * ease;
        posY += (mouseY - posY) * ease;
        cursor.style.left = posX + 'px';
        cursor.style.top = posY + 'px';
        requestAnimationFrame(animate);
      }
      animate();

      // Event untuk tangkap kedudukan tetikus
      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      // Klik berikan anim ringkas
      window.addEventListener('mousedown', () => cursor.classList.add('active'));
      window.addEventListener('mouseup', () => cursor.classList.remove('active'));

      // Tukar rupa kursor berdasarkan elemen dengan atribut data-cursor
      // Kita cari semua elemen yang ada data-cursor
      const elements = document.querySelectorAll('[data-cursor]');
      elements.forEach(el => {
        const type = el.getAttribute('data-cursor');
        el.addEventListener('mouseenter', () => {
          if (type === 'slack') {
            cursor.classList.add('slack');
            // Masukkan SVG Slack ke dalam kursor (jika mahu)
            cursor.innerHTML = slackSVG();
          } else {
            cursor.classList.remove('slack');
            cursor.innerHTML = ''; // kembali bulatan default
          }
        });
        el.addEventListener('mouseleave', () => {
          cursor.classList.remove('slack');
          cursor.innerHTML = '';
        });
      });

      // Fungsi mengembalikan SVG Slack (boleh ubah saiz/warna)
      function slackSVG(){
        return `
          <svg width="26" height="26" viewBox="0 0 122.8 122.8" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Sederhana Slack mark (kecil & warna) -->
            <path d="M30.7 0C24.5 0 19.7 4.8 19.7 11v18.6c0 6.2 4.8 11 11 11s11-4.8 11-11V11c0-6.2-4.8-11-11-11z" fill="#36C5F0"/>
            <path d="M30.7 39.7c-6.2 0-11 4.8-11 11s4.8 11 11 11h18.6c6.2 0 11-4.8 11-11s-4.8-11-11-11H30.7z" fill="#2EB67D"/>
            <path d="M92.1 73.1c6.2 0 11-4.8 11-11s-4.8-11-11-11H73.5c-6.2 0-11 4.8-11 11s4.8 11 11 11h18.6z" fill="#ECB22E"/>
            <path d="M92.1 34.5c6.2 0 11-4.8 11-11V4.9c0-6.2-4.8-11-11-11s-11 4.8-11 11v18.6c0 6.2 4.8 11 11 11z" fill="#E01E5A"/>
          </svg>
        `;
      }

      // Aksesibiliti: sembunyikan kursor jika keyboard fokus digunakan
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
          cursor.style.display = 'none';
          document.body.style.cursor = 'auto';
        }
      });

    })();
  </script>
</body>
</html>
